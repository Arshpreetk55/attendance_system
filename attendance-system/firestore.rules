//outside 
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isSignedIn() && getUser().role == role;
    }

    function isAdmin() { return isRole('admin'); }
    function isTeacher() { return isRole('teacher') || isRole('admin'); }
    function isStudent() { return isRole('student'); }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isTeacher());
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isTeacher();
      allow delete: if isTeacher();
    }

    // ── Attendance ────────────────────────────────────────────────────────────
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow create: if isTeacher()
        && request.resource.data.markedBy == request.auth.uid
        && (
          request.resource.data.adjustmentRequestId == null ||
          (
            request.resource.data.adjustmentRequestId != null
            && get(/databases/$(database)/documents/adjustmentRequests/$(request.resource.data.adjustmentRequestId)).data.toTeacherId == request.auth.uid
            && get(/databases/$(database)/documents/adjustmentRequests/$(request.resource.data.adjustmentRequestId)).data.status == 'accepted'
          )
        );
      allow update: if isSignedIn() && (
        isAdmin() || request.auth.uid == resource.data.markedBy
      );
      allow delete: if isAdmin();
    }

    // ── Subjects ──────────────────────────────────────────────────────────────
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Trades ────────────────────────────────────────────────────────────────
    match /trades/{tradeId} {
      allow read: if true; // Public for login dropdown
      allow write: if isAdmin();
    }

    // ── Timetables ────────────────────────────────────────────────────────────
    match /timetables/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() && (isOwner(teacherId) || isAdmin());
    }
    // ── Adjustment Requests ──────────────────────────────────────────────────
    match /adjustmentRequests/{reqId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.fromTeacherId ||
        request.auth.uid == resource.data.toTeacherId
      );

      allow create: if isTeacher()
        && request.resource.data.fromTeacherId == request.auth.uid
        && request.resource.data.departmentCode == getUser().departmentCode
        && (
          request.resource.data.toTeacherId == null ||
          request.resource.data.toTeacherId != request.auth.uid
        )
        && request.resource.data.status in ['pending', 'admin-pending'];

      allow update: if isAdmin() || (
        isTeacher()
        && request.auth.uid == resource.data.toTeacherId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected']
        && resource.data.status == 'pending'
      );

      allow delete: if false;
    }
    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isTeacher();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
